# Praman Evidence Engine — Environment Configuration Template
# Copy this file to .env and populate with your values
# NEVER commit .env to version control

# --- Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/praman?sslmode=require

# --- FastAPI
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=info

# --- Deployment
PORT=8000
WORKERS=2

# --- Cryptography (populated after key generation)
HMAC_KEY=your-client-held-key-here
ED25519_PRIVATE_KEY_PATH=/path/to/private-key.pem

# --- Telemetry (OpenTelemetry, Development mode)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Module Registration
MODULE_PRIVACY_ENABLED=true
MODULE_AI_RISK_ENABLED=true
