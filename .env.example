# Praman Evidence Engine — Environment Configuration Template
# Copy this file to .env and populate with your values
# NEVER commit .env to version control

# --- Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/praman?sslmode=require

# --- FastAPI
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=info

# --- Deployment
PORT=8000
WORKERS=2

# --- Cryptography (populated after key generation)
HMAC_KEY=your-client-held-key-here
ED25519_PRIVATE_KEY_PATH=/path/to/private-key.pem

# Stable Ed25519 signing key: PEM, then base64-encoded (so it survives being
# passed through an environment variable without newline-mangling). Required
# for the "environment" key custody provider. Generate one with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; import base64; k = Ed25519PrivateKey.generate(); print(base64.b64encode(k.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())).decode())"
# See docs/DEPLOYMENT.md.
ED25519_PRIVATE_KEY_PEM=
KEY_CUSTODY_PROVIDER=environment

# --- Telemetry (OpenTelemetry, Development mode)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Module Registration
MODULE_PRIVACY_ENABLED=true
MODULE_AI_RISK_ENABLED=true

# --- Demo mode (api/routers/demonstration.py)
# Defaults false. Enables POST /demo/tamper-attempt, which issues a live
# (always-rolled-back) UPDATE against the ledger to demonstrate the
# append-only trigger rejecting it. Never enable against a deployment
# holding real tenant data — see docs/ADR/0015-demo-tamper-endpoint.md.
DEMO_MODE_ENABLED=false
